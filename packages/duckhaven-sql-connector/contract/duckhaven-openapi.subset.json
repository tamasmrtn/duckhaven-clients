    "/workspaces/{workspace}/sql/sessions": {
      "post": {
        "description": "Open a session, starting compute first when none is up.\n\nSynchronous by contract \u2014 it returns a session a client can immediately run\nstatements on \u2014 so when compute has to start it holds the request rather than\nparking silently. `wait_timeout_s`/`on_wait_timeout` choose how long and what\nhappens at the end: 503 + Retry-After (the default, for a client that cannot\npoll) or 202 with a pending session (for one that can).",
        "operationId": "open_session",
        "parameters": [
          {
            "in": "path",
            "name": "workspace",
            "required": true,
            "schema": {
              "title": "Workspace",
              "type": "string"
            }
          }
        ],
        "requestBody": {
