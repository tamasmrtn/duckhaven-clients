  "openapi": "3.1.0",
  "paths": {
    "/queries/{query_id}": {
      "delete": {
        "description": "Ask the agent to stop a running query.\n\nBest effort and idempotent: cancelling a query that already finished is a\nno-op, not an error. The query row survives -- cancellation is a terminal\nstatus, not a deletion.",
        "operationId": "cancel_query",
        "parameters": [
          {
            "in": "path",
            "name": "query_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Query Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "No valid session cookie or bearer token was supplied."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Authenticated, but not permitted to perform this operation."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "No such resource, or the caller may not know it exists."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "summary": "Cancel Query",
        "tags": [
          "queries"
        ]
      },
      "get": {
        "description": "One query's status, timings and error, by its global id.\n\nAddressed globally rather than under its workspace: the id is unique, and the\nsubmitter already holds it. Any member of the query's workspace may read it,\nwhich is what makes the history an audit trail.",
        "operationId": "get_query",
        "parameters": [
          {
            "in": "path",
            "name": "query_id",
            "required": true,
            "schema": {
