    "/queries/{query_id}/rows": {
      "get": {
        "description": "A page of a finished query's result rows, with their column types.\n\nA result grid rather than a resource collection, which is why the envelope is\n`rows`/`columns` rather than `items`. Page with the opaque `cursor`.",
        "operationId": "get_query_rows",
        "parameters": [
          {
            "in": "path",
            "name": "query_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Query Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
