  "openapi": "3.1.0",
  "paths": {
    "/queries/{query_id}": {
      "delete": {
        "description": "Ask the agent to stop a running query.\n\nBest effort and idempotent: cancelling a query that already finished is a\nno-op, not an error. The query row survives -- cancellation is a terminal\nstatus, not a deletion.",
        "operationId": "cancel_query",
        "parameters": [
          {
            "in": "path",
            "name": "query_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Query Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "No valid session cookie or bearer token was supplied."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Authenticated, but not permitted to perform this operation."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "No such resource, or the caller may not know it exists."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "summary": "Cancel Query",
        "tags": [
          "queries"
        ]
      },
      "get": {
        "description": "One query's status, timings and error, by its global id.\n\nAddressed globally rather than under its workspace: the id is unique, and the\nsubmitter already holds it. Any member of the query's workspace may read it,\nwhich is what makes the history an audit trail.\n\nPass `wait_timeout_s` to hold the response until the query reaches a terminal\nstate, for a client following a statement that outlived the wait on submit.\nIt is **opt-in and defaults to 0** deliberately: this is also the route the\nworksheet refreshes several times a second and the history reads, and neither\nwants a held request. Capped by `SQL_STATEMENT_MAX_WAIT_TIMEOUT_S`.",
        "operationId": "get_query",
        "parameters": [
          {
            "in": "path",
            "name": "query_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Query Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "wait_timeout_s",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Wait Timeout S",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "No valid session cookie or bearer token was supplied."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Authenticated, but not permitted to perform this operation."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "No such resource, or the caller may not know it exists."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get Query",
        "tags": [
          "queries"
        ]
      }
    },
    "/queries/{query_id}/result": {
      "get": {
        "description": "A finished query's whole result in a columnar format.\n\nExact where JSON is not: every value keeps its type (DECIMAL as decimal,\n64-bit and wider integers as integers), and the result streams in one response\ninstead of 1000-row pages. `column_schema` on the query names each column's\nDuckDB type. Guarded exactly like `/rows`.",
        "operationId": "get_query_result",
        "parameters": [
          {
            "in": "path",
            "name": "query_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Query Id",
              "type": "string"
            }
          },
          {
            "description": "`arrow` for an Arrow IPC stream, `parquet` for the file as is.",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "arrow",
              "description": "`arrow` for an Arrow IPC stream, `parquet` for the file as is.",
              "enum": [
                "arrow",
                "parquet"
              ],
              "title": "Format",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/vnd.apache.arrow.stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "application/vnd.apache.parquet": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The whole result, as an Arrow IPC stream or a Parquet file."
          },
          "204": {
            "content": {
              "application/vnd.apache.arrow.stream": {
                "schema": {
                  "format": "binary",
