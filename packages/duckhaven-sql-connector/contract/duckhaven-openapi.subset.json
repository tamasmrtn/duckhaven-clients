    "/sql/sessions/{session_id}/statements": {
      "post": {
        "description": "Run a statement on this session's DuckDB connection. 200 if it finished\nwithin `wait_timeout_s`, 202 with a query id if it is still running.\n\nUnlike `POST /workspaces/{workspace}/queries`, this reuses one held connection, so\ntemp tables, `SET`s and attached catalogs persist between statements. 409 if\nthe session is not open.\n\nThe call blocks for up to `wait_timeout_s` (server default\n`SQL_STATEMENT_WAIT_TIMEOUT_S`, `0` to never block) so a client learns the\nstatement finished when it does, instead of on its own next poll. A statement\nthat outlives the budget comes back 202 and is polled through\n`GET /queries/{id}` as before \u2014 it is never cancelled for outrunning a wait.",
        "operationId": "run_statement",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
